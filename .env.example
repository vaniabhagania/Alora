# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). The .env file is gitignored.
#
# Only the "anon"/"public" key belongs here. Anything prefixed with VITE_ is
# embedded into the client bundle and is therefore public -- never put the
# service_role key in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
